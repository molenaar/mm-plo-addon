# Local BMad install state (regenerated by `npx bmad-method install`)
_bmad/
_bmad-output/

# Claude Code / BMad runtime skill installs (vendored deps, not addon source)
.claude/skills/
.agents/

# Claude Code local settings (machine-specific permissions)
.claude/settings.local.json

# Python bytecode
__pycache__/
*.pyc

# BMad Builder scan/analysis artifacts and process logs
**/.analysis/
**/.memlog.md
**/.decision-log.md
